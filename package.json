{
    "name": "next-image-srcset",
    "version": "1.0.0",
    "description": "src set generation and components",
    "license": "ISC",
    "type": "module",
    "main": "./dist/node/index.cjs",
    "module": "./dist/node/index.mjs",
    "exports": {
        "./node": {
            "import": "./dist/node/index.mjs",
            "require": "./dist/node/index.cjs"
        },
        "./next": {
            "import": "./src/next/index.jsx"
        },
        "./react": {
            "import": "./src/react/index.jsx"
        },
        ".": {
            "import": "./dist/node/index.mjs",
            "require": "./dist/node/index.cjs"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "npm run build:node",
        "build:node": "node build.js",
        "prepare": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jebbbbe/next-image-srcset.git"
    },
    "dependencies": {
        "prettier": "^3.6.2",
        "sharp": "^0.34.4"
    },
    "peerDependencies": {
        "next": "14.2.5",
        "react": "^18"
    },
    "devDependencies": {
        "esbuild": "^0.23.0"
    }
}
